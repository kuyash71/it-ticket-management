{
  "name": "it-ticket-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "node -e \"console.log('No frontend tests yet')\"",
    "build": "tsc -p tsconfig.json && vite build",
    "build:dev": "VITE_AUTH_BYPASS=true tsc -p tsconfig.json && VITE_AUTH_BYPASS=true vite build",
    "docker:prepare": "npm ci && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "axios": "^1.7.9",
    "i18next": "^24.2.0",
    "keycloak-js": "^26.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.1"
  }
}
